# Copie para .env (nunca versionado): cp .env.example .env
# Depois: docker compose up --build

# ── Obrigatório ──────────────────────────────────────────────────────────────

# Credenciais do MongoDB local. Use só letras e números: elas entram na URI.
MONGO_ROOT_USERNAME=repertorio
MONGO_ROOT_PASSWORD=troque_esta_senha_local

# Segredo das sessões de login. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Permite criar contas em /cadastro no desenvolvimento. Em produção é sempre ignorado.
AUTH_ALLOW_DEV_SIGNUP=true

# Cadastro público na Vercel: exige HTTPS e confirmação de e-mail pelo Resend.
# Configure um remetente de domínio verificado no Resend (somente o endereço de e-mail).
# AUTH_ALLOW_SIGNUP=true
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=contas@seu-dominio.com.br

# ── Opcional (comentado = usa o padrão) ──────────────────────────────────────

# Portas na sua máquina e nome do banco.
# APP_PORT=3000
# MONGO_PORT=27017
# MONGODB_DB_NAME=repertorio_dev

# Links públicos de repertórios (desligados por padrão).
# Gere o segredo com: openssl rand -base64 32. Trocá-lo invalida todos os links já publicados.
# PUBLIC_SHARING_ENABLED=true
# SHARE_LINK_SECRET=

# Só para rodar o Next.js fora do Docker (pnpm dev). No Docker, o compose define estes valores.
# MONGODB_URI=mongodb://repertorio:troque_esta_senha_local@localhost:27017/?authSource=admin&directConnection=true
# MONGODB_DB_NAME=repertorio_dev
# BETTER_AUTH_URL=http://localhost:3000

# Limites de links públicos (SHARE_MAX_*) e de contribuições (CONTRIBUTION_MAX_*): veja os padrões no README.
