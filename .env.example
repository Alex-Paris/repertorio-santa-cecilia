# Copie para .env (nunca versionado). Valores apenas de desenvolvimento.

# Portas na máquina local
APP_PORT=3000
MONGO_PORT=27017

# Credenciais do MongoDB local. Use somente letras e números, pois entram na URI.
MONGO_ROOT_USERNAME=repertorio
MONGO_ROOT_PASSWORD=troque_esta_senha_local

MONGODB_DB_NAME=repertorio_dev

# Usada ao rodar o Next.js fora do Docker. No Docker, o compose define a URI interna.
# directConnection é necessário fora do Docker: o membro do replica set se chama "mongo".
MONGODB_URI=mongodb://repertorio:troque_esta_senha_local@localhost:27017/?authSource=admin&directConnection=true

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Fora do Docker. No Docker, o compose deriva este valor de APP_PORT.
BETTER_AUTH_URL=http://localhost:3000

# Permite criar contas de teste. É ignorado em produção.
AUTH_ALLOW_DEV_SIGNUP=true

# Cadastro público na Vercel: exige HTTPS e confirmação de e-mail pelo Resend.
# Configure um remetente de domínio verificado no Resend (somente o endereço de e-mail).
# AUTH_ALLOW_SIGNUP=true
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=contas@seu-dominio.com.br

# Compartilhamento público de repertórios. Desativado por padrão, inclusive em produção.
PUBLIC_SHARING_ENABLED=false

# Assina os links públicos. Gere com: openssl rand -base64 32
# Perder ou trocar esta chave invalida TODOS os links já publicados.
SHARE_LINK_SECRET=

# Limites opcionais. Em branco, valem os padrões documentados no README.
SHARE_MAX_LINKS_PER_REPERTOIRE=
SHARE_MAX_LINKS_PER_USER=
SHARE_MAX_ITEMS=
SHARE_MAX_SNAPSHOT_BYTES=
SHARE_MAX_WRITES_PER_HOUR=

# Contribuições ao catálogo (Etapa 2F.1). Em branco: 5 em andamento por conta, 10 novas por dia
# e cifra de até 50 mil caracteres.
CONTRIBUTION_MAX_PENDING=
CONTRIBUTION_MAX_PER_DAY=
CONTRIBUTION_MAX_CHORDPRO_LENGTH=
